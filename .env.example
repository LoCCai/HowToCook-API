# 监听端口
PORT=3000
# 监听地址
HOST=127.0.0.1

# 内容根目录（含 dishes/ 与 tips/）。
# 留空时自动探测：上一级目录（与 HowToCook 主仓库同仓开发）→ ./content（首次启动自动从官方仓库下载到此处）。
CONTENT_DIR=

# 资源反代地址（如 https://cdn.example.com）。
# 配置后 image_mode=proxy 会把文档中的图片地址重写为
#   ${ASSET_BASE_URL}/dishes/aquatic/小龙虾/成品.jpg
# 由客户端自行从反代拉取；留空则默认使用 server 模式（本服务自己分发）。
ASSET_BASE_URL=

# 默认图片地址模式：relative | server | proxy
# 未设置时：配置了 ASSET_BASE_URL 则为 proxy，否则为 server。
# 任何端点都可用 ?image_mode= 查询参数临时覆盖。
DEFAULT_IMAGE_MODE=

# 开发模式：监视 dishes/ 与 tips/ 目录变化并自动重建索引
WATCH=0
